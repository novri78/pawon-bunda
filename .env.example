# =========================
# Application
# =========================
APP_ENV="production"
APP_NAME="Qwen AI - Pawon Bunda"
APP_VERSION="1.0.0"

# =========================
# AI Provider
# =========================
QWEN_API_KEY=replace-with-provider-key
GROQ_BASE_URL="https://api.groq.com/openai/v1"
MODEL_NAME="qwen/qwen3.6-27b"

# =========================
# AI behavior
# =========================
TEMPERATURE=0.6
MAX_COMPLETION_TOKENS=500

# =========================
# Security
# =========================
CORS_ORIGINS=
RATE_LIMIT_PER_MINUTE=30

# =========================
# Logging
# =========================
LOG_LEVEL=INFO